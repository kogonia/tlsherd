# Sample environment for tlsherd-server (install as /etc/tlsherd/server.env, mode 0600).

# Required. Use sslmode=verify-full for a remote database.
TLSHERD_DATABASE_URL=postgres://tlsherd:CHANGE_ME@127.0.0.1:5432/tlsherd?sslmode=disable

# Optional login for the auto-created first admin (default: admin).
# A random password is logged once at WARN on first start; change it after login.
#TLSHERD_BOOTSTRAP_LOGIN=admin

# Separate listeners (must differ).
# Admin: web UI + operator/admin JSON API.
TLSHERD_ADMIN_LISTEN=:8443
# Agents: enroll / poll / cert download / apply-result only.
TLSHERD_AGENT_LISTEN=:8444
# Legacy alias for admin listen (used only if TLSHERD_ADMIN_LISTEN is unset):
#TLSHERD_LISTEN=:8443

# Certificates, private keys and metadata of managed domains. Back this up.
TLSHERD_DATA_DIR=/var/lib/tlsherd

# HTTPS is the default and requires both files (the server's own certificate).
# The same cert/key is used for both listeners.
TLSHERD_TLS_CERT=/etc/tlsherd/server.crt
TLSHERD_TLS_KEY=/etc/tlsherd/server.key

# Plain HTTP (only behind a TLS-terminating reverse proxy or in a lab):
#TLSHERD_INSECURE_HTTP=1
# Behind a reverse proxy, take the client IP from the last X-Forwarded-For entry.
# Agents are bound to their source IP, so set this ONLY when the proxy overwrites the header.
#TLSHERD_TRUST_PROXY=1

# debug|info|warn|error
TLSHERD_LOG_LEVEL=info
