# Sample environment for tlsherd-agent (install as /etc/tlsherd/agent.env, mode 0600).

# Required: base URL of the tlsherd *agent* listener (not the admin UI port).
TLSHERD_SERVER_URL=https://tlsherd.example.com:8444

# Root of the managed certificate tree: <cert_root>/<fqdn>/{current,versions,backups}.
TLSHERD_CERT_ROOT=/etc/tls

# Holds state.json, config.cfg and config.cfg.prev (0600).
TLSHERD_STATE_DIR=/var/lib/tlsherd-agent

# Agent-priority local config (service, verify, restart, install/paths).
# Install sample: deploy/agent.local.cfg → /etc/tlsherd-agent/agent.local.cfg
# Server UI edits are pushed here on poll; previous file kept as *.prev.
TLSHERD_AGENT_LOCAL_CONFIG=/etc/tlsherd-agent/agent.local.cfg

# Optional: extra CA bundle (PEM) to trust for the server's TLS certificate.
#TLSHERD_CA_FILE=/etc/tlsherd/ca.pem

# debug|info|warn|error
TLSHERD_LOG_LEVEL=info
