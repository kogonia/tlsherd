[Unit]
Description=TLS Herd agent
Documentation=https://github.com/kogonia/tlsherd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/tlsherd/agent.env
ExecStart=/usr/local/bin/tlsherd-agent
Restart=on-failure
RestartSec=10s
# Verify/restart come from agent.local.cfg (agent-priority; server may push edits).
# They run as the agent user (root in this unit). Keep the network perimeter tight.
User=root
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
# Adjust to TLSHERD_CERT_ROOT / TLSHERD_STATE_DIR / TLSHERD_AGENT_LOCAL_CONFIG.
ReadWritePaths=/etc/tls /etc/systemd /var/lib/tlsherd-agent /etc/tlsherd-agent
StateDirectory=tlsherd-agent
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
