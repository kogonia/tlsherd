[Unit]
Description=TLS Herd server
Documentation=https://github.com/kogonia/tlsherd
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
# Create once: useradd --system --home /var/lib/tlsherd --shell /usr/sbin/nologin tlsherd
User=tlsherd
Group=tlsherd
# See deploy/server.env. Mode 0600, owner root (contains the database password).
EnvironmentFile=/etc/tlsherd/server.env
ExecStart=/usr/local/bin/tlsherd-server
# For plain HTTP behind a reverse proxy use: ExecStart=/usr/local/bin/tlsherd-server --insecure-http
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

# Certificates and private keys live in the data directory.
StateDirectory=tlsherd
StateDirectoryMode=0750
UMask=0027

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Privileged ports (<1024) for admin/agent listeners need:
# AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadWritePaths=/var/lib/tlsherd

[Install]
WantedBy=multi-user.target
